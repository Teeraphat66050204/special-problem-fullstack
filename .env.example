# Copy this file to .env and replace only values appropriate for your environment.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/app
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Set OCR_PROVIDER=disabled to turn OCR off. The API key is intentionally empty.
OCR_PROVIDER=typhoon
TYPHOON_API_KEY=
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_OCR_MODEL=typhoon-ocr
OCR_TIMEOUT_SECONDS=120
OCR_MAX_PAGES=6
