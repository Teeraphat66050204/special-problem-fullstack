# Example local development credentials only; replace them outside development.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5433
MAX_UPLOAD_BYTES=20971520

# For a locally run API, the default is:
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/app
# For the API container, use db as the hostname if overriding the URL:
# DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
